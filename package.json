{
  "name": "printartz",
  "version": "0.1.0",
  "private": true,
  "description": "PrintArtZ.co.in — India-first printable school-project image generator",
  "scripts": {
    "dev": "pnpm --filter @printartz/web dev",
    "build": "pnpm --filter @printartz/web build",
    "start": "pnpm --filter @printartz/web start",
    "lint": "pnpm --filter @printartz/web lint",
    "db:generate": "pnpm --filter @printartz/db generate",
    "db:migrate": "pnpm --filter @printartz/db migrate",
    "db:push": "pnpm --filter @printartz/db push",
    "db:studio": "pnpm --filter @printartz/db studio"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.1"
}
