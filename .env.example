# =============================================================================
# PrintArtZ.com — Environment Variable Reference
# Copy this to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# SUPABASE — Database
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# SUPABASE — Project keys
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE — Storage S3
S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_PREVIEWS="printartz-previews"
S3_BUCKET_FINALS="printartz-finals"
S3_REGION="ap-south-1"

# OPENAI
OPENAI_API_KEY=""
AI_TEXT_MODEL="gpt-4o-mini"
AI_IMAGE_MODEL="gpt-image-1"
# Render quality vs cost: low (~$0.01) | medium (~$0.04, default) | high (~$0.17)
AI_IMAGE_QUALITY="medium"

# REDIS — Upstash
REDIS_URL=""

# AUTH — Auth.js / NextAuth
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# EMAIL — Resend
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="no-reply@printartz.co.in"
SUPPORT_EMAIL="support@printartz.co.in"

# PAYMENTS — Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# APP
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
