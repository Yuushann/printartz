// PrintArtZ database schema. Dimensions/domain logic live in app code;
// this models persistence only. See docs/PROJECT_LOG.md §11 for the data model draft.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  // New engine-free generator (queryCompiler + driver adapter). No native
  // query engine — required for Windows/arm64 where the Rust engine has no build.
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

// ------------------------------------------------------------------ enums

enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  REJECTED
  NEEDS_CLARIFICATION
  READY_FOR_GENERATION
  GENERATING
  GENERATED
  FAILED
  PAID
  DOWNLOADABLE
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AssetKind {
  PREVIEW
  FINAL
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ------------------------------------------------------------------ auth (NextAuth/Auth.js)

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String?
  image               String?
  role                Role     @default(USER)
  freeGenerationsUsed Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  projectRequests ProjectRequest[]
  paymentOrders   PaymentOrder[]
  downloads       Download[]
  auditLogs       AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------------------ domain

model ProjectRequest {
  id          String        @id @default(cuid())
  userId      String
  instruction String
  category    String
  paperSize   String
  style       String?
  paperColor  String?
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs GenerationJob[]

  @@index([userId])
  @@index([status])
}

model GenerationJob {
  id               String    @id @default(cuid())
  projectRequestId String
  status           JobStatus @default(QUEUED)
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  projectRequest ProjectRequest   @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  assets         GeneratedAsset[]

  @@index([projectRequestId])
  @@index([status])
}

model GeneratedAsset {
  id        String    @id @default(cuid())
  jobId     String
  kind      AssetKind
  storageKey String
  createdAt DateTime  @default(now())

  job       GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  downloads Download[]

  @@index([jobId])
}

model PaymentOrder {
  id             String        @id @default(cuid())
  userId         String
  razorpayOrderId String       @unique
  amount         Int // paise
  currency       String        @default("INR")
  status         PaymentStatus @default(CREATED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  assetId   String
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset GeneratedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PricingTier {
  id            String   @id @default(cuid())
  name          String
  uptoCount     Int? // null = no upper bound
  pricePerImage Int // paise
  createdAt     DateTime @default(now())
}

model GalleryExample {
  id        String   @id @default(cuid())
  title     String
  storageKey String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}
