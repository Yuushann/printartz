{
  "name": "@printartz/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "push": "dotenv -e ../../.env.local -- prisma db push",
    "migrate": "dotenv -e ../../.env.local -- prisma migrate dev",
    "studio": "dotenv -e ../../.env.local -- prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "dotenv-cli": "^8",
    "prisma": "^6",
    "typescript": "^5"
  }
}
