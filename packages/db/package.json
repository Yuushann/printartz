    "studio": "dotenv -e ../../.env.local -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6"
  },
  "devDependencies": {
    "prisma": "^6",
    "dotenv-cli": "^8",
    "typescript": "^5"
  }
}
